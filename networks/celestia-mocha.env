# Celestia Mocha testnet (consensus node)
NAME="Celestia Mocha"
CHAIN_ID="mocha-5"
BINARY="celestia-appd"
SERVICE="celestia-appd"
DEFAULT_HOME_DIR=".celestia-app"
DEFAULT_PORT_PREFIX=26
GH_REPO="celestiaorg/celestia-app"
FALLBACK_VERSION="v10.4.0-mocha"

GENESIS_URL="https://raw.githubusercontent.com/celestiaorg/networks/master/mocha-5/genesis.json"
MIN_GAS_PRICE="0.002utia"
SEEDS="ee9f90974f85c59d3861fc7f7edb10894f6ac3c8@84.32.215.148:26656,b402fe40f3474e9e208840702e1b7aa37f2edc4b@celestia-testnet-seed.itrocket.net:14656"
PEERS="53849d640006381d7bdca4d0de9506596c8d59af@188.40.66.173:11656,5de6dcfb9ab6c4d8882596b2ad42cef2b67afc76@139.84.244.61:26656,73e3f071fc2246608642a675bd9ecaee5a489641@216.152.153.85:26656,d5519e378247dfb61dfe90652d1fe3e2b3005a5b@176.9.127.54:12056,dbd78d7c61f1789814685d5ed37fb39ff054177d@135.181.227.236:39656"
RPC_SERVERS=(
  "https://celestia-testnet-rpc.polkachu.com"
  "https://rpc-mocha.pops.one"
)

MIN_CPU=8; MIN_RAM_GB=24; MIN_DISK_GB=500

# A fresh node joins at the current app version, so the standalone build
# is enough; the multiplexer build is only needed to replay old versions.
asset_name() {
  local a="x86_64"; [[ "$ARCH" == "arm64" ]] && a="arm64"
  echo "celestia-app-standalone_Linux_${a}.tar.gz"
}
checksum_name() { echo "checksums.txt"; }

# celestia-app refuses to start without BBR congestion control.
prepare_host() {
  if [[ "$(sysctl -n net.ipv4.tcp_congestion_control)" != "bbr" ]]; then
    info "enabling BBR congestion control"
    $SUDO modprobe tcp_bbr
    printf 'net.core.default_qdisc=fq\nnet.ipv4.tcp_congestion_control=bbr\n' \
      | $SUDO tee /etc/sysctl.d/99-celestia-bbr.conf >/dev/null
    $SUDO sysctl -q -p /etc/sysctl.d/99-celestia-bbr.conf
  fi
}
